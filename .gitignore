__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.env
*.log

# Measurement output: numbers belong in the issue that asked for them, not in git.
runs/
digests/
*.jsonl

# Compiler artefacts from tools/probe-89.bat
tools/obj/
*.obj

# Build output of tools/build-bench.ps1: binary, objects and the ggml-base.dll it
# needs beside it. Rebuilt from source, and tied to a build-native tree that the next
# ninja run replaces.
tools/build-bench/

# code blocks the CLI writes out of a reply
.crow/

# Release packages -- built by tools/pack-release.ps1, never versioned
dist/

# Worktrees the workflow orchestrator opens for one stage at a time.
.claude/worktrees/

# The server's slot-save-path when the client is run from a checkout. The
# installed layout keeps it under %LOCALAPPDATA%\Crow; a checkout would
# otherwise carry a session into the repository.
.session/

# The server binary, linked in for a dev checkout so `crow` can start it.
# The repo never carries binaries; the package builds its own bin/.
/bin/

# Same, for the name the manifest actually resolves to in a checkout:
# <install>/session, where <install> is the repository root.
/session/
