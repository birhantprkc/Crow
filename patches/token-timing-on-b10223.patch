+    }
+
     // ref: https://github.com/ggml-org/llama.cpp/pull/17046#discussion_r2503085732
     cparams.n_ctx = GGML_PAD(cparams.n_ctx, 256);
 
@@ -711,7 +720,14 @@ void llama_context::synchronize() {
     // add the evaluation to the stats
     if (n_queued_tokens == 1) {
         if (!cparams.no_perf) {
-            t_eval_us += ggml_time_us() - t_compute_start_us;
+            // The single-token duration was already being computed here and thrown into
+            // the sum in the same expression. Keeping it costs one push_back against a
+            // step that takes hundreds of milliseconds on this machine.
+            const int64_t t_step_us = ggml_time_us() - t_compute_start_us;
+            t_eval_us += t_step_us;
+            if (token_timing) {
+                t_eval_steps_us.push_back(t_step_us);
+            }
         }
         n_eval++;
     } else if (n_queued_tokens > 1) {
@@ -3221,11 +3237,20 @@ llama_perf_context_data llama_context::perf_get_data() const {
     return data;
 }
 
+const std::vector<int64_t> & llama_context::perf_eval_steps() const {
+    return t_eval_steps_us;
+}
+
 void llama_context::perf_reset() {
     t_start_us  = ggml_time_us();
     t_eval_us   = n_eval = 0;
     t_p_eval_us = n_p_eval = 0;
     n_reused    = 0;
+
+    // Cleared with the counter it belongs to. Left behind, a second measurement would
+    // append to the first and the step count would no longer match n_eval - which is
+    // the one check that says the distribution is per token at all.
+    t_eval_steps_us.clear();
 }
 
 llama_memory_breakdown llama_context::memory_breakdown() const {
@@ -4135,6 +4160,32 @@ void llama_perf_context_print(const llama_context * ctx) {
     LLAMA_LOG_INFO("%s:    graphs reused = %10d\n", __func__, data.n_reused);
 }
 
+// A getter, not a printer, and that distinction was paid for twice on 2026-08-03. First
+// attempt: the block sat in llama_perf_context_print, which common_perf_print never calls
+// - it rebuilds the same lines itself from llama_perf_context(). Second attempt: exported
+// as a printer and called from common, it ran and still reached nobody, because
+// LLAMA_LOG_INFO from this library is filtered at the default verbosity while LOG_INF from
+// common is not. The series is data; the formatting belongs where the other perf lines are
+// written.
+int32_t llama_perf_context_eval_steps(const llama_context * ctx, int64_t * out, int32_t n_max) {
+    if (ctx == nullptr) {
+        return 0;
+    }
+
+    const std::vector<int64_t> & steps = ctx->perf_eval_steps();
+    const int32_t n = (int32_t) steps.size();
+
+    if (out != nullptr && n_max > 0) {
+        const int32_t n_copy = std::min(n, n_max);
+        std::copy(steps.begin(), steps.begin() + n_copy, out);
+    }
+
+    // The FULL count, never the copied one. Returning min(n, n_max) would let a caller
+    // with a short buffer report a truncated series as a complete measurement, which is
+    // the failure shape this project keeps finding: a result that looks like an answer.
+    return n;
+}
+
 void llama_perf_context_reset(llama_context * ctx) {
     ctx->perf_reset();
 }
