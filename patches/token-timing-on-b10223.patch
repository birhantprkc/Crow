diff --git a/common/sampling.cpp b/common/sampling.cpp
index 256ac16..70dcf97 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -547,6 +547,80 @@ void common_perf_print(const struct llama_context * ctx, const struct common_sam
         LOG_INF("%s: unaccounted time = %10.2f ms / %5.1f %%      (total - sampling - prompt eval - eval) / (total)\n", __func__, t_unacc_ms, t_unacc_pc);
         LOG_INF("%s:    graphs reused = %10d\n", __func__, data.n_reused);
 
+        // Per-token decode times, right after the eval-time line they explain. That line
+        // is one sum over all steps and cannot tell "evenly slow" from "a few stalls",
+        // and on this machine decode varies by up to a factor of 2 between two identically
+        // configured runs with the cause unmeasured.
+        //
+        // Formatted here rather than inside llama.dll, and the reason is narrower than it
+        // looked when this was written. Library INFO is not unreachable, it is DEMOTED:
+        // common_get_verbosity maps GGML_LOG_LEVEL_INFO to LOG_LEVEL_TRACE (4) while
+        // params.verbosity defaults to 3, so common_log_default_callback drops it on
+        // 4 <= 3. Only messages from the library go through that callback - LOG_INF from
+        // common calls common_log_add directly and is never filtered, which is why the
+        // lines above appear and the library's did not. Measured 2026-08-03: -lv 4 brings
+        // library INFO through in full.
+        //
+        // The series stays here anyway. A diagnostic that needs a flag nobody remembers is
+        // a diagnostic that will be missing on the run that mattered.
+        //
+        // Not gated on the environment variable a second time. The series is only filled
+        // when the gate was open at context creation, so an empty one already means "off",
+        // and two checks are two things that can disagree.
+        const int32_t n_steps = llama_perf_context_eval_steps(ctx, nullptr, 0);
+        if (n_steps > 0) {
+            std::vector<int64_t> steps(n_steps);
+            const int32_t n_got = llama_perf_context_eval_steps(ctx, steps.data(), n_steps);
+
+            // THE CHECK, and it is not the sum. Each delta goes into t_eval_us and into
+            // the series in the same statement, so their total can never disagree - a test
+            // on it would pass against anything. What CAN go wrong is the mapping: n_eval
+            // counts decode steps, the series counts the ones that were timed, and if
+            // several single tokens are evaluated without a synchronisation in between
+            // they collapse into one measurement. That is the FIXME at the top of
+            // llama_context::synchronize(), and it would leave a distribution that answers
+            // a different question than the one asked.
+            if (n_got != data.n_eval) {
+                LOG_INF("%s: per-token eval = INVALID - %d steps timed against %d in n_eval\n",
+                        __func__, n_got, data.n_eval);
+                LOG_INF("%s:                  Steps were merged; one entry is not one token.\n", __func__);
+                LOG_INF("%s:                  No distribution is reported.\n", __func__);
+            } else {
+                int64_t t_min = steps[0];
+                int64_t t_max = steps[0];
+                for (const int64_t t : steps) {
+                    t_min = std::min(t_min, t);
+                    t_max = std::max(t_max, t);
+                }
+
+                LOG_INF("%s: per-token eval = %d steps, min %8.2f ms, max %8.2f ms, max/min %6.2fx\n",
+                        __func__, n_got, 1e-3*t_min, 1e-3*t_max,
+                        t_min > 0 ? (double) t_max / (double) t_min : 0.0);
+
+                // Raw microseconds, because this is the evidence and every later analysis
+                // divides it. Eight per line keeps a 32-token run readable and a longer
+                // one greppable.
+                std::string line;
+                for (int32_t i = 0; i < n_got; i++) {
+                    char buf[32];
+                    snprintf(buf, sizeof(buf), "%9lld", (long long) steps[i]);
+                    line += buf;
+                    if ((i + 1) % 8 == 0 || i + 1 == n_got) {
+                        LOG_INF("%s:    steps [us]:%s\n", __func__, line.c_str());
+                        line.clear();
+                    }
+                }
+            }
+        }
+
+        // Upstream PR #25294 inserts its expert-streaming statistics at exactly this anchor, in
+        // front of common_memory_breakdown_print. The per-token series above wants the same spot.
+        // Both are kept and both print: the series explains the shape of a token's time, the
+        // streaming stats explain how much of it was spent fetching experts, and reading one
+        // without the other is how a stall gets blamed on the wrong tier. No-op while streaming
+        // is off.
+        llama_moe_stream_print_stats(llama_get_model(ctx));
+
         common_memory_breakdown_print(ctx);
     }
 }
diff --git a/include/llama.h b/include/llama.h
index 6e53e22..0ca7dfc 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1564,6 +1564,25 @@ extern "C" {
     LLAMA_API void                           llama_perf_context_print(const struct llama_context * ctx);
     LLAMA_API void                           llama_perf_context_reset(      struct llama_context * ctx);
 
+    // Read the per-token decode times, in microseconds, in the order they were measured.
+    // Copies at most n_max into out, and RETURNS THE FULL COUNT - which is what lets a
+    // caller notice that its buffer was too small instead of reporting a truncated series
+    // as a complete one. Pass out = NULL, n_max = 0 to ask for the count alone.
+    //
+    // Returns 0 unless the environment variable LLAMA_TOKEN_TIMING was set when the
+    // context was created. That single gate is deliberate: a second check on the reading
+    // side could disagree with the one on the writing side.
+    //
+    // A getter rather than a printer, and rather than a field on llama_perf_context_data.
+    // The struct is copied by value across the ABI and a variable-length series does not
+    // belong in it. The printing lives in the application layer because llama.cpp's own
+    // LLAMA_LOG_INFO does not survive the default log verbosity - measured 2026-08-03,
+    // two attempts to print from inside the library reached nobody.
+    LLAMA_API int32_t llama_perf_context_eval_steps(
+            const struct llama_context * ctx,
+                              int64_t  * out,
+                              int32_t    n_max);
+
     // NOTE: the following work only with samplers constructed via llama_sampler_chain_init
     LLAMA_API struct llama_perf_sampler_data llama_perf_sampler      (const struct llama_sampler * chain);
     LLAMA_API void                           llama_perf_sampler_print(const struct llama_sampler * chain);
