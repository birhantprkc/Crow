@@ -280,6 +280,15 @@ llama_context::llama_context(
         }
     }
 
+    {
+        const char * LLAMA_TOKEN_TIMING = getenv("LLAMA_TOKEN_TIMING");
+        token_timing = LLAMA_TOKEN_TIMING ? (atoi(LLAMA_TOKEN_TIMING) != 0) : token_timing;
+
+        if (token_timing) {
+            LLAMA_LOG_WARN("%s: per-token timing enabled\n", __func__);
